// Fixture for textDocument/completion. This file compiles as it stands; the tests
// insert the incomplete expressions they need through didChange.
// Written for this repository - do not replace with code from other AnyDSL projects.

struct Point {
    x: i32,
    y: i32
}

enum Shape {
    Empty,
    Dot(Point)
}

// A module, so path completion has something to resolve behind `::`.
mod shapes {
    struct Circle { radius: i32 }
    fn area(c: Circle) -> i32 { c.radius * c.radius * 3 }
}

// No declared return type, so the server has to read it off the ForallType.
fn identity[T](value: T) = value;

// `for` needs a generator, so the tests that complete inside and after a loop need one.
fn @range(body: fn(i32) -> ()) -> fn(i32, i32) -> () {
    fn @(?beg & ?end) loop(beg: i32, end: i32) -> () {
        if beg < end {
            @body(beg);
            loop(beg + 1, end)
        }
    }
    loop
}

fn main() -> i32 {
    let shape = Shape::Dot(Point { x = 1, y = 2 });
    let scaled = identity(3);
    match shape {
        Shape::Empty => scaled,
        Shape::Dot(p) => p.x + p.y
    }
}
