// Fixture: consumes declarations from geometry.art, so navigation and
// diagnostics have to work across files within the same project.

fn length_squared(v: Vec2) -> f32 {
    dot(v, v)
}

fn main() -> i32 {
    let a = Vec2 { x = 1.0, y = 2.0 };
    let b = scale(a, 2.0);
    let c = add(a, b);
    let d = unwrap[f32](Box[f32] { item = 3.0 });
    if length_squared(c) > d { 0 } else { 1 }
}
