{
    "version": "0.2.0",
    "configurations": [
        {
			"type": "extensionHost",
			"request": "launch",
			"name": "Launch Client",
			"runtimeExecutable": "${execPath}",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}/vscode"],
			"outFiles": [
				"${workspaceFolder}/vscode/out/**/*.js"
			],
			"autoAttachChildProcesses": true,
			"preLaunchTask": "Build Extension with LSP Server"
		}
    ]
}
